FROM eclipse-temurin:25-jdk-alpine AS builder
WORKDIR /workspace

COPY gradlew gradlew.bat settings.gradle build.gradle ./
COPY gradle ./gradle
COPY gateway ./gateway

RUN --mount=type=cache,id=devkit-gradle,target=/root/.gradle \
    ./gradlew --no-daemon :gateway:bootJar \
    && cp gateway/build/libs/gateway-0.0.1-SNAPSHOT.jar /workspace/gateway.jar

FROM eclipse-temurin:25-jre-alpine
WORKDIR /application
RUN apk upgrade --no-cache \
    && addgroup -S -g 10001 devkit \
    && adduser -S -D -H -u 10001 -G devkit devkit
COPY --from=builder /workspace/gateway.jar ./gateway.jar

USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/application/gateway.jar"]
