# Keycloak database
KEYCLOAK_DB_NAME=
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=

# DevKit service database
DEVKIT_DB_NAME=
DEVKIT_DB_USER=
DEVKIT_DB_PASSWORD=
DEVKIT_DB_PORT=
DEVKIT_DB_URL=jdbc:postgresql://localhost:5433/devkit

# DevKit backend. Bind loopback when a local gateway is the public entrypoint.
DEVKIT_SERVER_ADDRESS=127.0.0.1
DEVKIT_SERVER_PORT=8080

# Gateway identity JWT trusted by the backend (not the Keycloak JWKS directly)
DEVKIT_GATEWAY_ISSUER=
DEVKIT_GATEWAY_JWK_SET_URI=
DEVKIT_GATEWAY_AUDIENCE=devkit-sync-api

# Keycloak issuer copied into the gateway JWT upstream_iss claim
DEVKIT_KEYCLOAK_ISSUER=

# Keycloak bootstrap admin
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Local access: http://localhost:8081
# Production: set this to the public HTTPS hostname, e.g. https://auth.example.com
KC_HOSTNAME=
KC_PROXY_HEADERS=
KEYCLOAK_PORT=

# Resource limits
KEYCLOAK_MEMORY_LIMIT=
KEYCLOAK_CPUS=
