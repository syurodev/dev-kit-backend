# Keycloak database
KEYCLOAK_DB_NAME=
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=

# Shared Redis for gateway rate limits and revocation denylist (compose stack)
DEVKIT_REDIS_PASSWORD=

# DevKit service database
DEVKIT_DB_NAME=
DEVKIT_DB_ADMIN_USER=devkit_owner
DEVKIT_DB_ADMIN_PASSWORD=
DEVKIT_DB_APP_USER=devkit_app
DEVKIT_DB_APP_PASSWORD=
DEVKIT_DB_PORT=
DEVKIT_DB_URL=jdbc:postgresql://localhost:5433/devkit

# DevKit backend. Bind loopback when a local gateway is the public entrypoint.
DEVKIT_SERVER_ADDRESS=127.0.0.1
DEVKIT_SERVER_PORT=8080

# Gateway identity JWT trusted by the backend (not the Keycloak JWKS directly)
DEVKIT_GATEWAY_ISSUER=http://localhost:8082
DEVKIT_GATEWAY_JWK_SET_URI=http://localhost:8082/.well-known/jwks.json
DEVKIT_GATEWAY_AUDIENCE=devkit-sync-api
DEVKIT_GATEWAY_PORT=8082
DEVKIT_GATEWAY_SERVER_ADDRESS=127.0.0.1
DEVKIT_GATEWAY_SERVER_PORT=8082
DEVKIT_BACKEND_URL=http://127.0.0.1:8080
DEVKIT_GATEWAY_TOKEN_TTL=45s
DEVKIT_GATEWAY_SIGNING_KEY_ID=devkit-gateway-local
DEVKIT_GATEWAY_SIGNING_KEY_DIR=./.local/gateway-keys
DEVKIT_GATEWAY_SIGNING_PRIVATE_KEY_PATH=./.local/gateway-keys/private.pem
DEVKIT_GATEWAY_SIGNING_PUBLIC_KEY_PATH=./.local/gateway-keys/public.pem
DEVKIT_GATEWAY_IP_REQUESTS_PER_MINUTE=120
DEVKIT_GATEWAY_SUBJECT_REQUESTS_PER_MINUTE=300
DEVKIT_GATEWAY_MAX_CONCURRENT_REQUESTS=64
DEVKIT_GATEWAY_MAX_TRACKED_KEYS=10000

# Enrollment, storage backpressure and metadata retention
DEVKIT_DEVICE_ENROLLMENT_TTL=10m
DEVKIT_SYNC_MAX_OPERATIONS=1000000
DEVKIT_SYNC_MAX_BYTES=10737418240
DEVKIT_RETENTION_ENABLED=true
DEVKIT_AUDIT_RETENTION=90d
DEVKIT_RETENTION_CRON="0 15 3 * * *"

# Keycloak access token validated by the gateway. The Docker service uses an
# internal JWKS URI while retaining this public issuer for claim validation.
DEVKIT_KEYCLOAK_ISSUER=http://localhost:8081/realms/devkit
DEVKIT_KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/devkit/protocol/openid-connect/certs
DEVKIT_KEYCLOAK_AUDIENCE=devkit-sync-gateway

# Keycloak bootstrap admin
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Local access: http://localhost:8081
# Production: set this to the public HTTPS hostname, e.g. https://auth.example.com
KC_HOSTNAME=
KC_PROXY_HEADERS=
KEYCLOAK_PORT=

# Resource limits
KEYCLOAK_MEMORY_LIMIT=
KEYCLOAK_CPUS=
