# syntax=docker/dockerfile:1.7

# The official PostgreSQL image currently ships gosu 1.19 compiled with an old
# Go stdlib. Rebuild the same gosu release with a patched compiler toolchain.
FROM golang:1.25.12-alpine3.24 AS gosu-builder

RUN CGO_ENABLED=0 go install -trimpath -ldflags="-s -w" \
    github.com/tianon/gosu@v0.0.0-20250923190938-6456aaa0f3c8

FROM postgres:18-alpine

# Apply security updates that were published after the base image release.
RUN apk upgrade --no-cache

COPY --from=gosu-builder /go/bin/gosu /usr/local/bin/gosu
